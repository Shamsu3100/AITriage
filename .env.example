# mock   = free, no key, no internet. Best for learning.
# ollama = free forever, runs on your laptop, works offline
# claude = paid (about $0.0013 a call), needs ANTHROPIC_API_KEY
# hybrid = severity from code + wording from a model   <-- RECOMMENDED
PROVIDER=mock

# which model writes the wording when PROVIDER=hybrid
HYBRID_BACKEND=ollama

ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5
OLLAMA_MODEL=llama3.2:3b
